{
  "name": "meimap",
  "version": "0.2.1",
  "private": true,
  "description": "MeiMap：支持模拟定位与多途经点路线的 iPhone 风格 Windows 地图应用。 / An iPhone-inspired Windows map app with simulated location and multi-stop routes.",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke-test",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.meimap.app",
    "productName": "MeiMap",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable"
    }
  }
}
